rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ユーザー基本情報 =====
    match /users/{userId} {
      // 自分のドキュメントは全読み書き可
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 連携済みの親は子どものドキュメントを読める（ニックネーム取得等）
      allow read: if request.auth != null && isParentOf(userId);
      // 親は子どもの linkedParentUid / linkedParentUids のみ更新できる
      // （バッチ書き込み対応のため exists() チェックは外している）
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['linkedParentUid', 'linkedParentUids']);
    }

    // ===== 招待コード =====
    // inviteCodes/{code} に { childUid, parentUids[], createdAt } を保存する
    match /inviteCodes/{code} {
      // 認証済みユーザーは特定コードを直接読める（list は不可）
      allow get: if request.auth != null;
      // 子ども本人のみ作成できる（再発行も create）
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.childUid;
      // 親は parentUids フィールドのみ更新できる
      // （バッチ書き込み対応のため exists() チェックは外している）
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids']);
    }

    // ===== 日記記録（本人＋親のみ） =====
    match /dailyRecords/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && isParentOf(resource.data.uid);
    }

    // ===== 親子リンク =====
    match /parentChildLinks/{linkId} {
      // 個別ドキュメントの読み取り：親または子どものどちらも可
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.parentUid
            || request.auth.uid == resource.data.childUid);
      // list（全件クエリ）は許可しない
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.parentUid;
      allow write: if request.auth != null
        && request.auth.uid == resource.data.parentUid;
    }

    // ===== 週間もくひょう =====
    match /weeklyGoals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && isParentOf(resource.data.uid);
    }

    // ===== 親リアクション =====
    match /parentReactions/{reactionId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.parentUid
        && isParentOf(request.resource.data.childUid);
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.parentUid
            || request.auth.uid == resource.data.childUid);
    }

    // ===== ヘルパー =====
    function isParentOf(childUid) {
      return exists(/databases/$(database)/documents/parentChildLinks/$(request.auth.uid + '_' + childUid));
    }
  }
}
