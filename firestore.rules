rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // 1チーム限定運用（10人規模）向けのシンプルなルール
    // ログイン済みユーザー＝チームメンバーとみなす
    // ========================================

    // ===== ユーザー基本情報 =====
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 詳細記録（本人＋親のみ） =====
    match /privateRecords/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && isParentOf(resource.data.uid);
    }

    // ===== 公開要約（チーム内公開＝ログイン済み全員） =====
    match /publicSummaries/{summaryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // ===== 練習メニュー =====
    match /trainingMenus/{menuId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // ===== 親子リンク =====
    match /parentChildLinks/{linkId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.parentUid
            || request.auth.uid == resource.data.childUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.parentUid;
      allow write: if request.auth != null
        && request.auth.uid == resource.data.parentUid;
    }

    // ===== 週間もくひょう =====
    match /weeklyGoals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && isParentOf(resource.data.uid);
    }

    // ===== ナイス！ =====
    match /nices/{niceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.fromUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
    }

    // ===== ヘルパー =====
    function isParentOf(childUid) {
      return exists(/databases/$(database)/documents/parentChildLinks/$(request.auth.uid + '_' + childUid));
    }
  }
}
