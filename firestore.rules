rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ユーザー基本情報 =====
    match /users/{userId} {
      // 自分の読み書き
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 親が子どものプロフィールを読む
      allow read: if request.auth != null && isParentOf(userId);
      // チームメンバー同士はニックネームなどを読める（ランキング用）
      allow read: if request.auth != null && resource.data.role == 'child';
    }

    // ===== 詳細記録（本人＋親のみ） =====
    match /privateRecords/{recordId} {
      // 本人の読み書き
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      // 親が子どもの記録を読む
      allow read: if request.auth != null && isParentOf(resource.data.uid);
    }

    // ===== 公開要約（チーム内公開） =====
    match /publicSummaries/{summaryId} {
      // 本人の読み書き
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      // ログイン済みなら誰でも読める（チーム公開）
      allow read: if request.auth != null;
    }

    // ===== 練習メニュー =====
    match /trainingMenus/{menuId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      // 親が読む
      allow read: if request.auth != null && isParentOf(resource.data.uid);
      // チームメンバーが練習TOP3を集計するため読める
      allow read: if request.auth != null;
    }

    // ===== 親子リンク =====
    match /parentChildLinks/{linkId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == resource.data.parentUid
            || request.auth.uid == resource.data.childUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.parentUid;
    }

    // ===== ヘルパー関数 =====
    function isParentOf(childUid) {
      return exists(/databases/$(database)/documents/parentChildLinks/$(request.auth.uid + '_' + childUid));
    }
  }
}
